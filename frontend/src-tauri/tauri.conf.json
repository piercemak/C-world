{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CearaWorld",
  "version": "0.1.1",
  "identifier": "com.cearaworld.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CearaWorld",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEOTA2QzZCQzREOEIwNjcKUldSbnNOakVhMnlRdmVTR0VNQXhLSkNibE5wYWVUWDZFL1IycGpnbXI5YWxENmxRaEJRSkZhOFkK",
      "endpoints": [
        "https://github.com/piercemak/C-world/releases/latest/download/latest.json"
      ]
    }
  }
}
