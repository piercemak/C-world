<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene" focusable="true">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigChanged" />
    </interface>
    <children>
        <Rectangle id="background" width="1280" height="720" color="0x111318FF" />
        <Label id="brand" translation="[72,42]" text="CWorld" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="status" translation="[72,104]" width="1136" height="44" font="font:MediumSystemFont" color="0x9BA5B4FF" ellipsisText="..." />
        <Button id="allTitlesButton" translation="[72,145]" text="All Titles" minWidth="190" focusable="true" />
        <Button id="continueButton" translation="[280,145]" text="Continue Watching" minWidth="270" focusable="true" />
        <MarkupGrid id="catalogGrid" translation="[72,170]" itemComponentName="CatalogGridItem" numColumns="4" itemSize="[280,450]" numRows="1" />

        <Group id="loginView" visible="false">
            <Rectangle translation="[210,90]" width="860" height="560" color="0x1B222EFF" opacity="0.98" />
            <Label translation="[300,150]" text="Sign in to CWorld" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Button id="usernameInput" translation="[300,245]" width="680" height="64" text="Username" focusable="true" />
            <Button id="passwordInput" translation="[300,330]" width="680" height="64" text="Password" focusable="true" />
            <Button id="loginButton" translation="[300,430]" text="Sign in" minWidth="220" focusable="true" />
            <Label id="loginStatus" translation="[300,525]" width="680" height="44" font="font:MediumSystemFont" color="0xFFB86BFF" ellipsisText="..." />
        </Group>

        <Group id="deviceLoginView" visible="false">
            <Rectangle translation="[170,45]" width="940" height="630" color="0x1B222EFF" opacity="0.98" />
            <Label translation="[250,90]" text="Sign in with your phone" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Poster id="deviceQr" translation="[250,170]" width="250" height="250" loadDisplayMode="scaleToFit" />
            <Label id="deviceCode" translation="[560,195]" width="500" height="60" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" ellipsisText="..." />
            <Label id="deviceUrl" translation="[560,275]" width="500" height="70" font="font:MediumSystemFont" color="0xAEB8C7FF" wrap="true" ellipsisText="..." />
            <Label id="deviceStatus" translation="[560,355]" width="500" height="75" font="font:MediumSystemFont" color="0xFFB86BFF" wrap="true" ellipsisText="..." />
            <Button id="useRemoteLoginButton" translation="[560,465]" text="Use remote login" width="260" height="64" focusable="true" />
            <Button id="refreshDeviceButton" translation="[840,465]" text="New QR code" width="220" height="64" focusable="true" />
            <Label translation="[250,585]" width="810" height="42" text="Scan the code, sign in, and approve this TV in your browser." font="font:SmallSystemFont" color="0x9BA5B4FF" />
        </Group>

        <Group id="profileView" visible="false">
            <Rectangle translation="[210,90]" width="860" height="560" color="0x1B222EFF" opacity="0.98" />
            <Label translation="[300,150]" text="Choose a profile" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <MarkupList id="profileList" translation="[300,245]" itemComponentName="ProfileListItem" itemSize="[760,90]" />
            <Label id="profileStatus" translation="[300,610]" width="760" height="44" font="font:MediumSystemFont" color="0xFFB86BFF" ellipsisText="..." />
        </Group>

        <Group id="detailView" visible="false">
            <Poster id="detailPoster" translation="[72,80]" width="300" height="450" />
            <Label id="detailTitle" translation="[420,92]" width="770" height="70" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" ellipsisText="..." />
            <Label id="detailMeta" translation="[420,174]" width="770" height="42" font="font:MediumSystemFont" color="0xAEB8C7FF" ellipsisText="..." />
            <Label id="detailDescription" translation="[420,230]" width="770" height="140" font="font:MediumSystemFont" color="0xE0E5EDFF" wrap="true" ellipsisText="..." />
            <MarkupList id="episodeList" translation="[420,395]" itemComponentName="EpisodeListItem" itemSize="[1180,82]" visible="false" />
            <Button id="moviePlayButton" translation="[420,410]" text="Play" minWidth="220" visible="false" />
            <Label id="detailStatus" translation="[420,640]" width="770" height="40" font="font:MediumSystemFont" color="0xFFB86BFF" ellipsisText="..." />
        </Group>

        <Video id="video" translation="[0,0]" width="1280" height="720" visible="false" />
        <CatalogTask id="catalogTask" />
        <PlaybackTask id="playbackTask" />
        <LoginTask id="loginTask" />
        <ProfileTask id="profileTask" />
        <ProgressTask id="progressTask" />
        <HistoryTask id="historyTask" />
        <DeviceTask id="deviceTask" />
        <Timer id="devicePollTimer" duration="2" repeat="true" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
