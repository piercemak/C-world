<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigChanged" />
    </interface>
    <children>
        <Rectangle id="background" width="1280" height="720" color="#111318" />
        <Label id="brand" translation="[72,42]" text="CWorld" font="font:LargeBoldSystemFont" color="#ffffff" />
        <Label id="status" translation="[72,104]" width="1136" height="44" font="font:MediumSystemFont" color="#9ba5b4" ellipsisText="..." />
        <MarkupGrid id="catalogGrid" translation="[72,170]" itemComponentName="CatalogGridItem" numColumns="4" itemSize="[280,450]" numRows="1" />

        <Group id="loginView" visible="false">
            <Label translation="[300,150]" text="Sign in to CWorld" font="font:LargeBoldSystemFont" color="#ffffff" />
            <TextEditBox id="usernameInput" translation="[300,245]" width="680" height="64" hintText="Username" />
            <TextEditBox id="passwordInput" translation="[300,330]" width="680" height="64" hintText="Password" secureMode="true" />
            <Button id="loginButton" translation="[300,430]" text="Sign in" minWidth="220" />
            <Label id="loginStatus" translation="[300,525]" width="680" height="44" font="font:MediumSystemFont" color="#ffb86b" ellipsisText="..." />
        </Group>

        <Group id="profileView" visible="false">
            <Label translation="[300,150]" text="Choose a profile" font="font:LargeBoldSystemFont" color="#ffffff" />
            <MarkupList id="profileList" translation="[300,245]" itemComponentName="ProfileListItem" itemSize="[760,90]" />
            <Label id="profileStatus" translation="[300,610]" width="760" height="44" font="font:MediumSystemFont" color="#ffb86b" ellipsisText="..." />
        </Group>

        <Group id="detailView" visible="false">
            <Poster id="detailPoster" translation="[72,80]" width="300" height="450" />
            <Label id="detailTitle" translation="[420,92]" width="770" height="70" font="font:LargeBoldSystemFont" color="#ffffff" ellipsisText="..." />
            <Label id="detailMeta" translation="[420,174]" width="770" height="42" font="font:MediumSystemFont" color="#aeb8c7" ellipsisText="..." />
            <Label id="detailDescription" translation="[420,230]" width="770" height="140" font="font:MediumSystemFont" color="#e0e5ed" wrap="true" ellipsisText="..." />
            <MarkupList id="episodeList" translation="[420,395]" itemComponentName="EpisodeListItem" itemSize="[1180,82]" visible="false" />
            <Button id="moviePlayButton" translation="[420,410]" text="Play" minWidth="220" visible="false" />
            <Label id="detailStatus" translation="[420,640]" width="770" height="40" font="font:MediumSystemFont" color="#ffb86b" ellipsisText="..." />
        </Group>

        <Video id="video" translation="[0,0]" width="1280" height="720" visible="false" />
        <CatalogTask id="catalogTask" />
        <PlaybackTask id="playbackTask" />
        <LoginTask id="loginTask" />
        <ProfileTask id="profileTask" />
        <ProgressTask id="progressTask" />
        <HistoryTask id="historyTask" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
