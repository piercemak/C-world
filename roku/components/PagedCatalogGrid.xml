<?xml version="1.0" encoding="utf-8" ?>
<component name="PagedCatalogGrid" extends="Group">
 <interface>
  <field id="content" type="node" onChange="render" />
  <field id="jumpToItem" type="integer" alwaysNotify="true" onChange="jump" />
  <field id="itemFocused" type="integer" value="0" alwaysNotify="true" />
  <field id="itemSelected" type="integer" value="-1" alwaysNotify="true" />
  <field id="pageRequested" type="integer" alwaysNotify="true" />
 </interface>
 <children><Group id="slots" /></children>
 <script type="text/brightscript" uri="pkg:/components/PagedCatalogGrid.brs" />
</component>
